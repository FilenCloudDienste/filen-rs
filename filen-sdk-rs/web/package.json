{
	"name": "@filen/sdk-rs",
	"version": "0.5.10",
	"description": "Filen JS SDK using filen-sdk-rs",
	"type": "module",
	"scripts": {
		"build": "vite build -c vite.sw.config.ts",
		"test": "npm run build && { vitest run --browser.name=chromium; chromium=$?; vitest run --browser.name=firefox && exit $chromium; }",
		"ubrn:ios": "ubrn build ios --and-generate",
		"ubrn:android": "ubrn build android --and-generate",
		"ubrn:android:arm": "ubrn build android --and-generate -t arm64-v8a",
		"ubrn:android:x86": "ubrn build android --and-generate -t x86_64",
		"ubrn:checkout": "ubrn checkout",
		"ubrn:release": "ubrn build ios --release --and-generate && ubrn build android --release --and-generate",
		"build:napi": "napi build --platform --manifest-path ../Cargo.toml --features napi,cache,sync-engine,rclone --output-dir node --esm",
		"build:napi:release": "npm run build:napi -- --release",
		"test:napi": "node --test napi/smoke.test.mjs napi/parity.test.mjs",
		"test:napi:live": "node --test napi/live.test.mjs",
		"check:napi-parity": "node napi/parity.mjs"
	},
	"homepage": "https://github.com/FilenCloudDienste/filen-rs",
	"author": "Filen",
	"collaborators": [
		"Enduriel <endur1el@protonmail.com>"
	],
	"files": [
		"sdk-rs_bg.wasm",
		"sdk-rs_bg.wasm.d.ts",
		"sdk-rs.d.ts",
		"sdk-rs.js",
		"snippets",
		"service-worker",
		"filen-sdk-worker-thread.js",
		"android/src/main/",
		"android/build.gradle",
		"android/CMakeLists.txt",
		"android/cpp-adapter.cpp",
		"cpp",
		"ios",
		"FilenSdkRsFramework.xcframework",
		"src",
		"SdkRs.podspec",
		"node/index.js",
		"node/index.d.ts"
	],
	"main": "./sdk-rs.js",
	"react-native": "./src/index.tsx",
	"exports": {
		".": {
			"filen-desktop": {
				"types": "./node/index.d.ts",
				"default": "./node/index.js"
			},
			"react-native": {
				"android": {
					"import": "./src/index.tsx",
					"require": "./src/index.tsx",
					"types": "./src/index.tsx",
					"default": "./src/index.tsx"
				},
				"ios": {
					"import": "./src/index.tsx",
					"require": "./src/index.tsx",
					"types": "./src/index.tsx",
					"default": "./src/index.tsx"
				},
				"import": "./src/index.tsx",
				"require": "./src/index.tsx",
				"types": "./src/index.tsx",
				"default": "./src/index.tsx"
			},
			"browser": {
				"import": "./sdk-rs.js",
				"types": "./sdk-rs.d.ts"
			},
			"types": "./sdk-rs.d.ts",
			"import": "./sdk-rs.js",
			"default": "./sdk-rs.js"
		},
		"./sdk-rs_bg.wasm": {
			"import": "./sdk-rs_bg.wasm",
			"default": "./sdk-rs_bg.wasm"
		},
		"./service-worker/sdk-rs.js": "./service-worker/sdk-rs.js",
		"./service-worker/sdk-rs.d.ts": "./service-worker/sdk-rs.d.ts",
		"./service-worker/sdk-rs_bg.wasm": "./service-worker/sdk-rs_bg.wasm"
	},
	"sideEffects": [
		"./sdk-rs.js"
	],
	"license": "AGPL-3.0-only",
	"keywords": [
		"filen"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/FilenCloudDienste/filen-rs"
	},
	"engines": {
		"node": ">=23"
	},
	"devDependencies": {
		"@napi-rs/cli": "~3.10.8",
		"@types/node": "^24.19.1",
		"@types/serviceworker": "^0.0.203",
		"@vitest/browser": "^5.0.3",
		"@vitest/browser-playwright": "^5.0.3",
		"@zip.js/zip.js": "^2.23.0",
		"playwright": "^1.63.0",
		"prettier": "^3.9.9",
		"typescript": "~7.0.2",
		"vite": "^8.3.3",
		"vitest": "^5.0.3"
	},
	"napi": {
		"binaryName": "sdk-rs",
		"targets": [
			"aarch64-apple-darwin",
			"x86_64-apple-darwin",
			"x86_64-pc-windows-msvc",
			"aarch64-pc-windows-msvc",
			"x86_64-unknown-linux-gnu",
			"aarch64-unknown-linux-gnu"
		],
		"dtsHeaderFile": "napi/compat.d.ts",
		"constEnum": false,
		"runtimeStringEnum": true
	},
	"codegenConfig": {
		"name": "FilenSdkRsTurboModule",
		"type": "modules",
		"jsSrcsDir": "src",
		"android": {
			"javaPackageName": "io.filen.sdkrsturbomodule"
		}
	},
	"dependencies": {
		"uniffi-bindgen-react-native": "github:Enduriel/uniffi-bindgen-react-native#e0282ad3eb972eaea74225dcc06247b7a67204dd"
	}
}
