#!/usr/bin/env bash
# Fast checks that run before every commit.
# Mirrors a subset of .github/workflows/ci.yml — see pre-push for the heavier checks.
#
# These checks are required (see CLAUDE.md, Contributing). A tool they need that is
# missing stops the commit with an install message instead of skipping the check.

set -u
set -o pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

red=$'\033[31m'
green=$'\033[32m'
bold=$'\033[1m'
reset=$'\033[0m'

run() {
	local name=$1
	shift
	printf '%s==>%s %s\n' "$bold" "$reset" "$name"
	if "$@"; then
		printf '%s    ok%s\n' "$green" "$reset"
	else
		printf '%s    failed: %s%s\n' "$red" "$name" "$reset"
		printf '\n%spre-commit failed.%s Fix the issue above and commit again.\n' \
			"$red$bold" "$reset"
		exit 1
	fi
}

have() { command -v "$1" >/dev/null 2>&1; }

# Cargo fmt — fast, checks the whole workspace.
if have cargo; then
	run "cargo fmt --all -- --check" cargo fmt --all -- --check
	# Also run rustfmt inside filen-sdk-rs (separate workspace for wasm config).
	if [ -f filen-sdk-rs/Cargo.toml ]; then
		run "cargo fmt (filen-sdk-rs) -- --check" \
			bash -c 'cd filen-sdk-rs && cargo fmt -- --check'
	fi
else
	printf '%scargo not found — cannot run pre-commit checks%s\n' "$red" "$reset"
	exit 1
fi

# Taplo — TOML lint + format.
if have taplo; then
	run "taplo lint" env RUST_LOG=error taplo lint
	run "taplo fmt --check" env RUST_LOG=error taplo fmt --check
else
	printf '%staplo not installed; the TOML checks cannot run.%s\n' "$red$bold" "$reset"
	printf 'Install it with %scargo install taplo-cli --version 0.10.0 --locked%s.\n' "$bold" "$reset"
	exit 1
fi

# sqlfluff — only on staged SQL files for speed, so it is only needed when there are some.
staged_sql=$(git diff --cached --name-only --diff-filter=ACM -z \
	| tr '\0' '\n' | grep -E '\.sql$' || true)
if [ -z "$staged_sql" ]; then
	printf '%s==>%s sqlfluff: no staged .sql files\n' "$bold" "$reset"
elif have sqlfluff; then
	# shellcheck disable=SC2086
	run "sqlfluff lint (staged)" bash -c 'sqlfluff lint "$@"' _ $staged_sql
else
	printf '%ssqlfluff not installed; the staged .sql files cannot be linted.%s\n' "$red$bold" "$reset"
	printf 'Install it with %spip install sqlfluff%s.\n' "$bold" "$reset"
	exit 1
fi

# Diff policy — changes that need the maintainer's approval (see CLAUDE.md, Contributing).
if [ "${SKIP_DIFF_POLICY:-0}" = "1" ]; then
	printf '%s==>%s diff policy: skipped (SKIP_DIFF_POLICY=1)\n' "$bold" "$reset"
else
	run "diff policy (staged)" bash scripts/check-diff-policy.sh --cached
fi

# Default clippy config — the cheapest of the four CI clippy invocations.
# heif-decoder is excluded because its cmake-rs build breaks incremental compiles.
# See https://github.com/rust-lang/cmake-rs/issues/248
if have cargo; then
	run "cargo clippy -- -D warnings" \
		cargo clippy --workspace --exclude heif-decoder --all-targets -- -D warnings
fi

# UniFFI clippy for filen-sdk-rs (matches the mobile bindings build surface).
if have cargo; then
	run "cargo clippy -p filen-sdk-rs -F uniffi,http-provider -- -D warnings" \
		cargo clippy -p filen-sdk-rs -F uniffi,http-provider --all-targets -- -D warnings
fi

# Sync-engine clippy (a native-only feature not covered by the default or wasm runs);
# --all-targets also type-checks its live test binaries, and `malformed` the cases gated
# on it. Same command as ci-linux's sync engine pass.
if have cargo; then
	run "cargo clippy -p filen-sdk-rs -F sync-engine,malformed -- -D warnings" \
		cargo clippy -p filen-sdk-rs -F sync-engine,malformed --all-targets -- -D warnings
fi

# WASM clippy: the two configurations wasm-pack.sh ships (the service-worker one
# with default features OFF and its RUSTFLAGS), run from the filen-sdk-rs
# sub-workspace like the ci-wasm job does — minus `heif-decoder`.
#
# That omission is the one deliberate gap between this hook and ci-wasm. With
# `heif-decoder` every commit cross-compiles libheif + libde265 + dav1d for
# wasm32 and needs a wasi-sdk installed; pre-push runs that pass, on the exact
# feature sets CI uses. What stays here is the cheap half, and it is a strict
# subset of what CI lints.
if have cargo && [ -f filen-sdk-rs/Cargo.toml ]; then
	if rustup target list --installed 2>/dev/null | grep -q '^wasm32-unknown-unknown$'; then
		# `cache` compiles bundled SQLite C for wasm32, which Apple clang cannot
		# target — brew llvm, like CI. Dropping the feature instead would be worse
		# than not running this at all: the reduced set still reports ok while the
		# combination CI builds goes unchecked, the exact blind spot this check
		# exists to close. So: a clear stop, never a quiet downgrade.
		if [ "$(uname -s)" = "Darwin" ] && [ ! -x /opt/homebrew/opt/llvm/bin/clang ]; then
			printf '%sbrew llvm not found — cannot run the WASM clippy pass (-F wasm-full,cache).%s\n' \
				"$red$bold" "$reset"
			printf 'Install it with %sbrew install llvm%s.\n' "$bold" "$reset"
			exit 1
		fi
		# Scoped to this one command: the service-worker pass runs without them,
		# and they would otherwise persist into every later step. Seeded with a
		# bare `env` so the expansion is never empty: an empty array under
		# `set -u` is an unbound-variable error on bash < 4.4.
		wasm_cc=(env)
		if [ -x /opt/homebrew/opt/llvm/bin/clang ]; then
			wasm_cc=(env CC_wasm32_unknown_unknown=/opt/homebrew/opt/llvm/bin/clang \
				AR_wasm32_unknown_unknown=/opt/homebrew/opt/llvm/bin/llvm-ar)
		fi
		run "cargo clippy --target wasm32-unknown-unknown -F wasm-full,cache (filen-sdk-rs)" \
			"${wasm_cc[@]}" bash -c "cd filen-sdk-rs && cargo clippy --target wasm32-unknown-unknown -F wasm-full,cache -- -D warnings"
		run "cargo clippy --target wasm32-unknown-unknown --no-default-features -F service-worker (filen-sdk-rs)" \
			bash -c 'cd filen-sdk-rs && RUSTFLAGS="-C target-feature=-nontrapping-fptoint,+bulk-memory --cfg getrandom_backend=\"wasm_js\"" cargo clippy --target wasm32-unknown-unknown --no-default-features -F service-worker -- -D warnings'
	else
		printf '%swasm32-unknown-unknown target not installed; the WASM clippy passes cannot run.%s\n' \
			"$red$bold" "$reset"
		printf 'Install it with %srustup target add wasm32-unknown-unknown%s.\n' "$bold" "$reset"
		exit 1
	fi
fi

exit 0
