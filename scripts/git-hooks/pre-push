#!/usr/bin/env bash
# Heavier checks that run before every push.
# Mirrors .github/workflows/ci.yml: the Linux job's clippy configurations + unit
# tests, plus the ci-wasm job's clippy passes.
#
# To bypass in an emergency: git push --no-verify
#
# Env vars:
#   SKIP_HEAVY_CLIPPY=1   skip the heif-/avif-decoder clippy variants
#                         (heif-decoder breaks incremental builds — cmake-rs bug)
#   SKIP_TESTS=1          skip cargo test
#   SKIP_SQLFLUFF=1       skip the full-repo sqlfluff scan

set -u
set -o pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

red=$'\033[31m'
green=$'\033[32m'
yellow=$'\033[33m'
bold=$'\033[1m'
reset=$'\033[0m'

run() {
	local name=$1
	shift
	printf '%s==>%s %s\n' "$bold" "$reset" "$name"
	if "$@"; then
		printf '%s    ok%s\n' "$green" "$reset"
	else
		printf '%s    failed: %s%s\n' "$red" "$name" "$reset"
		printf '\n%spre-push failed.%s Fix the issue above, or run with --no-verify to bypass.\n' \
			"$red$bold" "$reset"
		exit 1
	fi
}

have() { command -v "$1" >/dev/null 2>&1; }

if ! have cargo; then
	printf '%scargo not found — cannot run pre-push checks%s\n' "$red" "$reset"
	exit 1
fi

# All-features clippy variants (matches CI). The heif-/avif-decoder builds can
# be slow on cold caches; gate them behind SKIP_HEAVY_CLIPPY for tight loops.
if [ "${SKIP_HEAVY_CLIPPY:-0}" != "1" ]; then
	run "cargo clippy -F heif-decoder,avif-decoder,malformed,multi-threaded-crypto -- -D warnings" \
		cargo clippy -F heif-decoder,avif-decoder,malformed,multi-threaded-crypto -- -D warnings
	run "cargo clippy -F heif-decoder,avif-decoder,malformed --no-default-features -- -D warnings" \
		cargo clippy -F heif-decoder,avif-decoder,malformed --no-default-features -- -D warnings
else
	printf '%sSKIP_HEAVY_CLIPPY=1, skipping heif-/avif-decoder clippy variants%s\n' \
		"$yellow" "$reset"
fi

run "cargo clippy -- -D warnings" cargo clippy -- -D warnings
run "cargo clippy --tests -- -D warnings" cargo clippy --tests -- -D warnings

# WASM clippy (matches ci.yml ci-wasm job; run from filen-sdk-rs sub-workspace).
if [ -f filen-sdk-rs/Cargo.toml ]; then
	if rustup target list --installed 2>/dev/null | grep -q '^wasm32-unknown-unknown$'; then
		# The cache feature compiles bundled SQLite C for wasm32, which Apple
		# clang cannot target — use brew llvm like CI does.
		wasm_full_feats="wasm-full,cache"
		if [ -x /opt/homebrew/opt/llvm/bin/clang ]; then
			export CC_wasm32_unknown_unknown=/opt/homebrew/opt/llvm/bin/clang
			export AR_wasm32_unknown_unknown=/opt/homebrew/opt/llvm/bin/llvm-ar
		elif [ "$(uname -s)" = "Darwin" ]; then
			printf '%sbrew llvm not found, dropping the cache feature from WASM clippy (install: brew install llvm)%s\n' \
				"$yellow" "$reset"
			wasm_full_feats="wasm-full"
		fi
		run "cargo clippy --target wasm32-unknown-unknown -F $wasm_full_feats (filen-sdk-rs)" \
			bash -c "cd filen-sdk-rs && cargo clippy --target wasm32-unknown-unknown -F $wasm_full_feats -- -D warnings"
		run "cargo clippy --target wasm32-unknown-unknown -F service-worker (filen-sdk-rs)" \
			bash -c 'cd filen-sdk-rs && cargo clippy --target wasm32-unknown-unknown -F service-worker -- -D warnings'
	else
		printf '%swasm32-unknown-unknown target not installed, skipping WASM clippy%s\n' \
			"$yellow" "$reset"
		printf '%s    install: rustup target add wasm32-unknown-unknown%s\n' "$yellow" "$reset"
	fi
fi

# Full-repo sqlfluff (matches CI).
if [ "${SKIP_SQLFLUFF:-0}" != "1" ] && have sqlfluff; then
	run "sqlfluff lint ." sqlfluff lint .
fi

if [ "${SKIP_TESTS:-0}" != "1" ]; then
	run "cargo test --lib --no-fail-fast" \
		cargo test --lib --no-fail-fast
else
	printf '%sSKIP_TESTS=1, skipping cargo test --lib%s\n' "$yellow" "$reset"
fi

exit 0
